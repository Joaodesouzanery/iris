# Configurações do servidor
PORT=3000

# URL base da ARTESP
ARTESP_BASE_URL=https://www.artesp.sp.gov.br

# Endpoint da Lovable (configurar na interface web)
LOVABLE_ENDPOINT=

# Delay entre requisições em ms (respeitar servidor)
REQUEST_DELAY=1000

# Timeout para requisições em ms
REQUEST_TIMEOUT=30000
