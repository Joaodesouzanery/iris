# Configuracoes do servidor
PORT=3000

# URL base da ARTESP
ARTESP_BASE_URL=https://www.artesp.sp.gov.br

# Endpoint da Lovable (configurar na interface web)
LOVABLE_ENDPOINT=

# ============================================
# INTEGRACAO SUPABASE (IRIS Regulation)
# ============================================
# OBRIGATORIO para funcionalidades de banco de dados.
# Obtenha suas credenciais em:
#   Supabase Dashboard > Settings > API
#   (https://app.supabase.com/project/_/settings/api)
#
# SUPABASE_URL        - URL do projeto (Project URL)
# SUPABASE_ANON_KEY   - Chave publica "anon public" (para leitura)
# SUPABASE_SERVICE_KEY - Chave "service_role" (para escrita, bypass RLS)
# ============================================

# URL do projeto Supabase (ex: https://abcdefgh.supabase.co)
SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co

# Chave publica (anon key) - encontrada em Settings > API > Project API keys
SUPABASE_ANON_KEY=COLE_SUA_ANON_KEY_AQUI

# Chave de servico (service_role key) - encontrada em Settings > API > Project API keys
# ATENCAO: Esta chave tem acesso total ao banco. Nao exponha no frontend.
SUPABASE_SERVICE_KEY=COLE_SUA_SERVICE_ROLE_KEY_AQUI

# Delays entre requisicoes (protecao contra bloqueio)
# Delay minimo em ms
MIN_DELAY=2000
# Delay maximo em ms
MAX_DELAY=5000

# Timeout para requisicoes em ms
REQUEST_TIMEOUT=30000

# Maximo de tentativas em caso de falha
MAX_RETRIES=3

# Anos a filtrar (separados por virgula)
ANOS_PERMITIDOS=2025,2026

# ============================================
# APIS EXTERNAS (Cruzamento de Dados)
# ============================================

# Portal da Transparencia (gov.br)
# Cadastro gratuito em: https://portaldatransparencia.gov.br/api-de-dados
# Apos cadastro, gere seu token em: https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
PORTAL_TRANSPARENCIA_API_KEY=seu-token-aqui
