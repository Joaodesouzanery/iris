# ============================================================================
# IRIS Platform - Production Environment Configuration
# ============================================================================
# IMPORTANT: Copy this file to .env and fill in ALL values before deploying.
# NEVER commit the .env file with real credentials to version control.
# ============================================================================

# ── Server Configuration ──
PORT=3000
NODE_ENV=production
# Trusted proxy (set to 1 if behind Nginx/Cloudflare, or specific IP)
TRUST_PROXY=1

# ── Authentication (REQUIRED - Generate strong secrets!) ──
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_64_byte_hex_secret
JWT_REFRESH_SECRET=CHANGE_ME_generate_64_byte_hex_secret_2
ADMIN_PASSWORD=CHANGE_ME_strong_password_min_12_chars

# ── Supabase Database (REQUIRED for production) ──
# Get from: Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── ARTESP Configuration ──
ARTESP_BASE_URL=https://www.artesp.sp.gov.br

# ── External APIs ──
# Portal da Transparencia: https://portaldatransparencia.gov.br/api-de-dados
PORTAL_TRANSPARENCIA_API_KEY=your-api-key-here

# ── Rate Limiting ──
# Delays between requests (protection against blocking)
MIN_DELAY=2000
MAX_DELAY=5000
REQUEST_TIMEOUT=30000
MAX_RETRIES=3

# ── Data Filtering ──
ANOS_PERMITIDOS=2025,2026

# ── Logging ──
LOG_LEVEL=info
# Set to 'true' to log to file (recommended in production)
LOG_TO_FILE=true

# ============================================================================
# SECURITY CHECKLIST BEFORE DEPLOYING:
# ============================================================================
# [ ] JWT_SECRET is a unique, random 64-byte hex string
# [ ] JWT_REFRESH_SECRET is a different unique, random 64-byte hex string
# [ ] ADMIN_PASSWORD is strong (12+ chars, mixed case, numbers, symbols)
# [ ] SUPABASE_SERVICE_KEY is set (needed for write operations)
# [ ] NODE_ENV is set to 'production'
# [ ] HTTPS is configured (via reverse proxy like Nginx/Caddy)
# [ ] .env file is NOT committed to git (.gitignore)
# [ ] Firewall rules restrict direct access to port 3000
# [ ] Database RLS (Row Level Security) is enabled in Supabase
# [ ] Supabase anon key has minimal permissions (read-only where possible)
# ============================================================================
