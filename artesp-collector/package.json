{
  "name": "artesp-collector",
  "version": "1.0.0",
  "description": "Sistema de coleta e extração de PDFs de deliberações da ARTESP",
  "main": "server.js",
  "scripts": {
    "start": "node server-unified.js",
    "old": "node server.js",
    "dev": "node --watch server-unified.js",
    "cli": "node cli.js",
    "cli:force": "node cli.js --force",
    "cli:status": "node cli.js --status",
    "cli:help": "node cli.js --help",
    "supabase": "node cli-supabase.js",
    "supabase:force": "node cli-supabase.js --force",
    "supabase:dry-run": "node cli-supabase.js --dry-run"
  },
  "bin": {
    "artesp-collector": "./cli.js"
  },
  "keywords": [
    "artesp",
    "pdf",
    "scraper",
    "deliberacoes"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "axios": "^1.6.7",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "pdf-parse": "^1.1.1",
    "rss-parser": "^3.13.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
